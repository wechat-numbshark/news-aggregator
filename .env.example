# ── 数据库 ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=newsdb
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── OpenRouter (翻译/分类/摘要 LLM) ──────────────────
# 申请地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 主力翻译模型：qwen3-235b 性价比最高，中/英/日都强
OPENROUTER_TRANSLATE_MODEL=qwen/qwen3-235b-a22b:free
# 备用快速模型（batch场景）
OPENROUTER_FAST_MODEL=google/gemini-2.0-flash-exp:free

# ── 飞书 Webhook ─────────────────────────────────────
# 在飞书群 -> 机器人 -> 自定义机器人 中创建
FEISHU_WEBHOOK_STOCK_CN=
FEISHU_WEBHOOK_STOCK_US=
FEISHU_WEBHOOK_STARTUP=
FEISHU_WEBHOOK_GENERAL=

# ── WeChat（WeWe-RSS 实例地址，需自己部署）────────────
# 部署文档: https://github.com/cooderl/wewe-rss
WEWRSS_BASE_URL=http://localhost:4000
WEWRSS_AUTH_CODE=

# ── NYT API ─────────────────────────────────────────
# 申请地址: https://developer.nytimes.com
NYT_API_KEY=

# ── 代理（可选，访问X/推特或国外源时用）────────────────
HTTP_PROXY=
HTTPS_PROXY=

# ── 运行控制 ──────────────────────────────────────────
LOG_LEVEL=INFO
DRY_RUN=true                      # 演示默认不推送
MAX_ARTICLES_PER_RUN=500          # 单次最大处理条数
